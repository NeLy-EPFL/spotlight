#!/usr/bin/env bash
#
# Utility to reset the cameras without physically power cycling them.
# Usage: reset-camera <behavior|muscle>

set -euo pipefail

CYCLE_DELAY=5  # seconds the USB port stays disabled before re-enabling
BEHAVIOR_CAM_SUBSTR="Euresys S.A. Device"
MUSCLE_CAM_SUBSTR="PCO AG pco.panda 4.2"

die() {
    echo "Error: $*" >&2
    exit 1
}

require() {
    command -v "$1" &>/dev/null || die "'$1' required but not found."
}

assert_one_match() {
    local -n _matches="$1"  # nameref to caller's array
    if [[ ${#_matches[@]} -eq 0 ]]; then
        die "No matching device found."
    fi
    if [[ ${#_matches[@]} -gt 1 ]]; then
        echo "Error: Multiple matching devices found:" >&2
        printf '  %s\n' "${_matches[@]}" >&2
        exit 1
    fi
    echo "Found: ${_matches[0]}"
}

confirm() {
    echo "$1"
    read -r -p "Proceed? [y/N] " yn
    if [[ ! $yn =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
    fi
}

# Echo the root-hub link speed (Mbps) of the port whose 'disable' file is $1.
# Used to bring the SuperSpeed port up before its slower USB 2.0 companion.
port_link_speed() {
    local port_dir
    port_dir="$(dirname "$1")"
    cat "$(readlink -f "$port_dir")/../../speed" 2>/dev/null || echo 0
}

reset_behavior_cam() {
    require lspci

    mapfile -t matches < <(lspci -D | grep -F "$BEHAVIOR_CAM_SUBSTR" || true)
    assert_one_match matches

    pci_addr=$(echo "${matches[0]}" | awk '{print $1}')
    reset_file="/sys/bus/pci/devices/${pci_addr}/reset"

    if [[ ! -f "$reset_file" ]]; then
        die "Device does not support Function Level Reset (no reset file at ${reset_file})."
    fi

    confirm "Ready to reset PCI device at address ${pci_addr} via ${reset_file}."

    echo "Resetting..."
    echo 1 | sudo tee "$reset_file" > /dev/null || die "Failed to write to ${reset_file}."
    echo "Done."
}

reset_muscle_cam() {
    # It's better to power cycle the muscle USB camera using uhubctl, but the
    # camera is directly plugged into the motherboard's native USB ports, which
    # do not support per-port power switching. Instead, we are disabling and
    # re-enabling the link via sysfs, which is not really a *power* cycle.
    #
    # If a real power cycle is needed, just unplug and replug the USB cable.
    # It's way easier than the behavior camera through the frame brabber.
    require lsusb

    mapfile -t matches < <(lsusb | grep -F "$MUSCLE_CAM_SUBSTR" || true)
    assert_one_match matches

    bus=$(echo "${matches[0]}"    | awk '{print $2}' | sed 's/^0*//')
    devnum=$(echo "${matches[0]}" | awk '{print $4}' | tr -d ':' | sed 's/^0*//')

    sysfs_name=$(find /sys/bus/usb/devices/ -maxdepth 1 -name "${bus}-*" ! -name "*:*" \
        -exec sh -c '
            val=$(cat "$1/devnum" 2>/dev/null | sed "s/^0*//")
            [ "$val" = "$2" ] && basename "$1"
        ' _ {} "$devnum" \; 2>/dev/null | head -1)

    if [[ -z "$sysfs_name" ]]; then
        die "Could not find sysfs entry for Bus ${bus} Device ${devnum}."
    fi

    # Resolve the port object's 'disable' file from the device's sysfs name.
    #   root-hub port (e.g. "2-6")  → iface "2-0:1.0", port object "usb2-port6"
    #   chained hub   (e.g. "2-1.3")→ iface "2-1:1.0", port object "2-1-port3"
    if [[ "$sysfs_name" =~ \. ]]; then
        hub_dev="${sysfs_name%.*}"
        port="${sysfs_name##*.}"
        hub_iface="${hub_dev}:1.0"
        port_obj="${hub_dev}-port${port}"
    else
        port="${sysfs_name##*-}"
        hub_iface="${bus}-0:1.0"
        port_obj="usb${bus}-port${port}"
    fi
    port_dir="/sys/bus/usb/devices/${hub_iface}/${port_obj}"
    disable_file="${port_dir}/disable"

    if [[ ! -f "$disable_file" ]]; then
        die "Port disable control not found at ${disable_file}."
    fi

    # A USB3 receptacle exposes the SuperSpeed link and its USB 2.0 companion as
    # two separate port objects that are each other's 'peer'. Disabling only the
    # port the device currently sits on leaves the peer enabled, so the
    # still-connected camera immediately re-enumerates on the peer -- and a
    # SuperSpeed device that lands on its USB 2.0 companion gets stuck at
    # 480 Mbps, which is too slow to transfer every muscle frame (~70% are then
    # dropped on the link). To force a clean re-enumeration that re-trains
    # SuperSpeed -- like a physical replug -- disable BOTH the port and its peer
    # during the off window, then re-enable both.
    disable_files=("$disable_file")
    peer_dir=$(readlink -f "${port_dir}/peer" 2>/dev/null || true)
    if [[ -n "$peer_dir" && -f "${peer_dir}/disable" ]]; then
        disable_files+=("${peer_dir}/disable")
        echo "Cycling port ${port_obj} and its companion $(basename "$peer_dir")."
    else
        echo "Warning: no peer (USB 2.0 companion) port found; cycling only" \
             "${port_obj}. The device may re-enumerate at USB 2.0 speed." >&2
    fi

    # Re-enable SuperSpeed first. A USB3 device only trains SuperSpeed if its SS
    # port is live before it can fall back to the (slower) USB 2.0 companion. If
    # the companion came up first the still-connected camera would enumerate at
    # 480 Mbps and never re-train SuperSpeed -- exactly the failure we are fixing
    # (and the reason this matters most when resetting an already-downgraded
    # camera, where the found port IS the USB 2.0 one). Order the re-enable by
    # descending root-hub link speed so the SuperSpeed port is restored first.
    mapfile -t reenable_files < <(
        for f in "${disable_files[@]}"; do
            echo "$(port_link_speed "$f") $f"
        done | sort -rn | awk '{print $2}')

    confirm "Ready to disable/re-enable the USB port(s) for bus=${bus} device=${devnum} port=${port} (and its USB 2.0 companion) so the camera re-trains SuperSpeed."

    # Safety net: restore every port we touch on exit, SuperSpeed first. Installed
    # *before* the disabling writes so that an interrupt (or a partial write) in
    # between cannot leave a port stuck disabled; re-enabling a port that was
    # never disabled is a harmless no-op.
    trap 'echo "Restoring port(s)..."; for f in "${reenable_files[@]}"; do echo 0 | sudo tee "$f" >/dev/null 2>&1 || true; done' EXIT

    echo "Disabling port(s)..."
    for f in "${disable_files[@]}"; do
        echo 1 | sudo tee "$f" > /dev/null || die "Failed to disable port ($f)."
    done

    echo "Waiting ${CYCLE_DELAY}s..."
    sleep "$CYCLE_DELAY"

    echo "Re-enabling port(s), SuperSpeed first..."
    first=1
    for f in "${reenable_files[@]}"; do
        echo 0 | sudo tee "$f" > /dev/null || die "Failed to re-enable port ($f)."
        # Give the SuperSpeed link a moment to train before the USB 2.0
        # companion goes live, so the device does not settle on 480 Mbps.
        if [[ $first -eq 1 && ${#reenable_files[@]} -gt 1 ]]; then
            sleep 1
            first=0
        fi
    done
    trap - EXIT
    echo "Done. Verify the camera re-trained SuperSpeed (expect 5000 Mbps):"
    echo "  for d in /sys/bus/usb/devices/*; do [ \"\$(cat \$d/idVendor 2>/dev/null)\" = 1cb2 ] && echo \"pco.panda: \$(cat \$d/speed) Mbps\"; done"
}

if [[ "${1:-}" == "behavior" ]]; then
    reset_behavior_cam
elif [[ "${1:-}" == "muscle" ]]; then
    reset_muscle_cam
else
    die "Invalid argument. Usage: reset-camera <behavior|muscle>"
fi